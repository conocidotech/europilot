# Europilot gateway environment -- copy to /etc/europilot/gateway.env, chmod 600.
# The systemd units load this file. Never commit the real key.

# Ed25519 signing seed (base64). Generate with: gen_signing_key.py gen
# Its public half MUST equal the value pinned in europilot/{ndw,osm}/client.py
# and europilot/flags.py, else devices reject every signature. Verify with:
#   gen_signing_key.py pubkey --seed "$EUROPILOT_OSM_SIGNING_KEY"
EUROPILOT_OSM_SIGNING_KEY=REPLACE_WITH_BASE64_SEED

# Optional: a dedicated NDW key. Unset -> NDW reuses EUROPILOT_OSM_SIGNING_KEY
# (gateway/ndw/sign.py). Keep unset unless you deliberately split identities.
#EUROPILOT_NDW_SIGNING_KEY=

# Data locations (referenced by the systemd units).
EUROPILOT_NDW_SHAPEFILE=/var/lib/europilot/ndw/msi_shp.zip
EUROPILOT_OSM_TILE_DIR=/var/lib/europilot/osm/tiles
EUROPILOT_OSM_PBF=/var/lib/europilot/osm/netherlands-latest.osm.pbf
EUROPILOT_OSM_PBF_URL=https://download.geofabrik.de/europe/netherlands-latest.osm.pbf
